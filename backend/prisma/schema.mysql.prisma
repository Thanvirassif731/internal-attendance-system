datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(uuid())
  name           String
  username       String         @unique
  email          String         @unique
  password       String
  role           String         @default("USER") // "ADMIN" | "USER"
  status         String         @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  designation    String?
  rollNumber     String?        @unique
  avatar         String?
  teamId         String?
  team           Team?          @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams       Team[]         @relation("TeamLead")
  tasks          Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  announcements  Announcement[] @relation("AuthoredAnnouncements")
  attendances    Attendance[]
  leaveRequests  LeaveRequest[] @relation("UserLeaves")
  reviewedLeaves LeaveRequest[] @relation("AdminReviewedLeaves")
  lastLogin      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([email])
  @@index([username])
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  leadId      String?
  lead        User?    @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     User[]   @relation("TeamMembers")
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  status      String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "REVIEW" | "COMPLETED"
  progress    Int       @default(0) // 0 to 100
  dueDate     DateTime?
  completedAt DateTime?
  userId      String    // Assignee
  user        User      @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?   // Creator
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([teamId])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  priority    String    @default("IMPORTANT") // "IMPORTANT" | "MEETING" | "NOTICE" | "GENERAL"
  expiryDate  DateTime?
  isReposted  Boolean   @default(false)
  originalId  String?
  authorId    String
  author      User      @relation("AuthoredAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  attachment  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([priority])
}

model Attendance {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String   // Format: YYYY-MM-DD
  checkInTime  String?  // e.g. "09:01 AM"
  checkOutTime String?  // e.g. "06:01 PM"
  status       String   @default("PRESENT") // "PRESENT" | "LATE" | "ABSENT" | "ON_LEAVE"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model LeaveRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveDate    String    // Format: YYYY-MM-DD
  reason       String
  description  String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedById String?
  reviewedBy   User?     @relation("AdminReviewedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}
