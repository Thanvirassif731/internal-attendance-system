# .gitignore for Internal Attendance System (KITE)

# Node modules
node_modules/
package-lock.json

# Build output
backend/dist/
frontend/dist/

# Environment files
.env
.env.example

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Misc
coverage/
*.log
